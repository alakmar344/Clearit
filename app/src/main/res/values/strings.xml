    <!-- Help / about -->
    <string name="help_title">How to use Clearit</string>
    <string name="help_body">1. Tap “Open photo” (or share a photo to Clearit from any app).\n\n2. AUTO: tap “Auto enhance”. Choose which areas auto may change and how strongly.\n\n3. PRESETS: one-tap looks, fully editable afterwards.\n\n4. MANUAL: Light, Color, Detail and Effects tabs contain every slider. Long-press a slider name to reset it.\n\n5. SIZE &amp; ROTATE: rotate, flip and upscale 2×–4×.\n\n6. Long-press the photo to see the original, or turn on Compare for a split view. Pinch to zoom, double-tap to zoom in/out.\n\n7. Tap Save to choose JPEG, PNG or WebP. Photos are saved at full resolution to Pictures/Clearit. Your original is never modified.</string>
    <string name="about_title">About Clearit</string>
    <string name="about_body">Clearit %1$s\n\nOn-device photo enhancer. No network access, no accounts, no tracking — your photos never leave your phone.</string>
